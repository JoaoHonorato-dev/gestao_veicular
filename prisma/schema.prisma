// Configuração do Prisma — gera o cliente TypeScript a partir deste arquivo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Status de rastreamento do veículo (online = com sinal, offline = sem sinal).
enum VehicleStatus {
  ONLINE
  OFFLINE
}

/// Veículo cadastrado no sistema (campos do CRUD).
model Vehicle {
  id        Int           @id @default(autoincrement())
  plate     String        @unique // placa — única no banco
  model     String                 // modelo do veículo
  driver    String                 // nome do motorista
  status    VehicleStatus @default(OFFLINE)
  createdAt DateTime      @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
